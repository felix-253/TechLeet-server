@startuml UC-02: Tạo tin tuyển dụng thủ công
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 5

actor "Nhà tuyển dụng" as HiringManager
boundary "Giao diện tạo tin tuyển dụng" as JobPostingUI
control "JobPostingController" as JobPostingController
entity "JobPostingRepository" as JobPostingRepo
entity "CompanyRepository" as CompanyRepo
database "Cơ sở dữ liệu" as Database

HiringManager -> JobPostingUI: Chọn "Tạo tin tuyển dụng"
JobPostingUI -> JobPostingController: Yêu cầu hiển thị form tạo tin
JobPostingController -> CompanyRepo: Lấy danh sách phòng ban
CompanyRepo -> Database: Truy vấn danh sách phòng ban
Database --> CompanyRepo: Trả về danh sách phòng ban
CompanyRepo --> JobPostingController: Dữ liệu phòng ban
JobPostingController -> JobPostingUI: Hiển thị form nhập thông tin

HiringManager -> JobPostingUI: Nhập thông tin chi tiết và nhấn "Lưu"

JobPostingUI -> JobPostingController: Gửi dữ liệu tin tuyển dụng
JobPostingController -> JobPostingController: Kiểm tra tính hợp lệ của dữ liệu

alt [Dữ liệu hợp lệ]
    JobPostingController -> JobPostingRepo: Tạo tin tuyển dụng mới
    JobPostingRepo -> Database: Lưu tin tuyển dụng vào cơ sở dữ liệu
    Database --> JobPostingRepo: Xác nhận lưu thành công
    JobPostingRepo --> JobPostingController: Tin tuyển dụng đã được tạo
    
    JobPostingController -> JobPostingController: Tạo mã tin tuyển dụng duy nhất
    JobPostingController -> JobPostingController: Đặt trạng thái DRAFT
    
    JobPostingController -> JobPostingUI: Thông báo tạo tin thành công
    JobPostingUI -> HiringManager: Chuyển đến trang chỉnh sửa tin tuyển dụng
else [Dữ liệu không hợp lệ]
    JobPostingController -> JobPostingUI: Thông báo lỗi validation
    JobPostingUI -> HiringManager: Quay lại màn hình nhập liệu với thông báo lỗi
end

@enduml