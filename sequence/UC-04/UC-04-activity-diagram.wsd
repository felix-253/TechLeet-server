@startuml UC-04: Cập nhật thông tin tuyển dụng

|Hiring Manager|
start
:Đăng nhập hệ thống;
:Truy cập danh sách tin tuyển dụng;
:Chọn tin cần chỉnh sửa;

|System|
:Kiểm tra quyền chỉnh sửa;
:Load thông tin tin tuyển dụng;

if (Có quyền chỉnh sửa?) then (Có)
  |Hiring Manager|
  :Hiển thị form chỉnh sửa;
  :Cho phép sửa đổi thông tin;
  note right
    - Tiêu đề và mô tả
    - Yêu cầu ứng viên
    - Mức lương
    - Số lượng và hạn ứng tuyển
    - Trạng thái tin tuyển dụng
  end note
  
  |System|
  :Validate dữ liệu đã sửa;
  
  if (Dữ liệu hợp lệ?) then (Có)
    :Cập nhật tin tuyển dụng trong DB;
    :Lưu lịch sử thay đổi;
    :Kiểm tra trạng thái mới;
    
    if (Trạng thái = PUBLISHED?) then (Có)
      :Gửi thông báo đến ứng viên;
    endif
    
    |Hiring Manager|
    :Hiển thị thông báo cập nhật thành công;
    stop
  else (Không)
    |Hiring Manager|
    :Hiển thị lỗi validation;
    :Cho phép chỉnh sửa lại;
    stop
  endif
else (Không)
  |Hiring Manager|
  :Hiển thị lỗi không có quyền;
  stop
endif

@enduml