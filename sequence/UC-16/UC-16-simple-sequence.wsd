@startuml UC-016: Luồng xử lý tự động tuyển dụng
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 5

actor "Ứng viên" as Candidate
boundary "Giao diện ứng viên" as CandidateUI
control "ApplicationController" as ApplicationController
control "ApplicationService" as ApplicationService
control "InformationService" as InformationService
control "CvTextExtractionService" as TextExtractionService
control "CvNlpProcessingService" as NlpService
control "CvLlmSummaryService" as LlmService
entity "CandidateRepository" as CandidateRepo
entity "ApplicationRepository" as ApplicationRepo

Candidate -> CandidateUI: Upload CV và thông tin ứng tuyển
CandidateUI -> ApplicationController: POST /applications/extract-from-pdf\n(pdfFilePath, jobPostingId)

ApplicationController -> ApplicationService: extractApplicationFromPdfs(pdfFilePath, jobPostingId)
activate ApplicationService

ApplicationService -> InformationService: extractCandidateInformationFromPdf(pdfFilePath, jobPostingId)
activate InformationService

InformationService -> TextExtractionService: extractTextFromPdf(pdfFilePath)
activate TextExtractionService
TextExtractionService -> TextExtractionService: Extract text from PDF file
TextExtractionService --> InformationService: extractedTextResult
deactivate TextExtractionService

InformationService -> NlpService: processCvText(extractedText)
activate NlpService
NlpService -> NlpService: Extract structured data:\ntotalExperienceYears, skills,\neducation, contactInfo
NlpService --> InformationService: processedData
deactivate NlpService

InformationService -> LlmService: generateCvSummary(text, processedData)
activate LlmService
LlmService -> LlmService: AI analysis:\nsummary, keyHighlights,\nconcerns, fitScore, recommendation
LlmService --> InformationService: aiSummaryResult
deactivate LlmService

InformationService -> InformationService: createOrUpdateCandidate(processedData, candidateId, senderEmail)
InformationService -> CandidateRepo: findOne({ email }) OR create()
activate CandidateRepo
CandidateRepo -> CandidateRepo: findOne() OR save()
CandidateRepo --> InformationService: candidate
deactivate CandidateRepo

alt [Job posting exists]
    InformationService -> InformationService: createApplication(candidateId, jobPostingId, processedData, aiAnalysis)
    InformationService -> ApplicationRepo: findOne({ jobPostingId, candidateId })
    activate ApplicationRepo
    ApplicationRepo -> ApplicationRepo: Check if exists
    ApplicationRepo --> InformationService: existingApplication | null
    deactivate ApplicationRepo
    
    alt [Application exists]
        InformationService --> ApplicationService: return existingApplication
    else [Application new]
        InformationService --> ApplicationService: candidateId, extractedData
        ApplicationService -> ApplicationService: create(CreateApplicationDto)
        ApplicationService -> ApplicationRepo: findOne({ jobPostingId })
        activate ApplicationRepo
        ApplicationRepo --> ApplicationService: jobPosting
        deactivate ApplicationRepo
        
        ApplicationService -> ApplicationService: Validate:\n- jobPosting.status === 'published'\n- deadline > now()
        ApplicationService -> ApplicationRepo: create() + save()
        activate ApplicationRepo
        ApplicationRepo -> ApplicationRepo: create + save
        ApplicationRepo --> ApplicationService: savedApplication
        deactivate ApplicationRepo
        
        ApplicationService --> ApplicationController: ApplicationResponseDto
    end
    
else [No job posting]
    InformationService --> ApplicationService: Candidate only (no application)
end

deactivate InformationService
ApplicationController --> CandidateUI: 201 Created\nApplicationResponseDto
deactivate ApplicationService

CandidateUI -> Candidate: Hiển thị kết quả và thông báo đã nhận hồ sơ

@enduml
