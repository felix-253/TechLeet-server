@startuml UC-011: Đánh giá ứng viên

|Interviewer|
start
:Từ lịch phỏng vấn đã hoàn thành;
:Click "Đánh giá ứng viên";

|System|
:Kiểm tra quyền đánh giá;
:Load thông tin phỏng vấn;

if (Có quyền đánh giá?) then (Có)
  :Lấy thông tin ứng viên;
  :Lấy thông tin tin tuyển dụng;
  
  |Interviewer|
  :Hiển thị form đánh giá;
  :Nhập kết quả đánh giá;
  note right
    - Điểm số tổng thể (1-10)
    - Kết quả (PASS/FAIL/MAYBE)
    - Điểm mạnh của ứng viên
    - Điểm yếu của ứng viên
    - Nhận xét chi tiết
    - Đề xuất vòng tiếp theo
  end note
  
  |System|
  :Validate dữ liệu đánh giá;
  :Tính toán điểm số tổng hợp;
  
  if (Dữ liệu hợp lệ?) then (Có)
    :Lưu kết quả đánh giá vào DB;
    :Cập nhật trạng thái phỏng vấn: COMPLETED;
    :Cập nhật trạng thái đơn ứng tuyển;
    
    if (Kết quả = PASS?) then (Có)
      :Set trạng thái: PASSED_INTERVIEW;
      :Gửi thông báo đến Hiring Manager;
    elseif (Kết quả = FAIL)
      :Set trạng thái: FAILED_INTERVIEW;
      :Gửi thông báo từ chối đến ứng viên;
    else (MAYBE)
      :Set trạng thái: PENDING_REVIEW;
      :Gửi thông báo đến Hiring Manager;
    endif
    
    |Interviewer|
    :Hiển thị thông báo đánh giá thành công;
    stop
  else (Không)
    |Interviewer|
    :Hiển thị lỗi validation;
    :Cho phép chỉnh sửa lại;
    stop
  endif
else (Không)
  |Interviewer|
  :Hiển thị lỗi không có quyền;
  stop
endif

@enduml
