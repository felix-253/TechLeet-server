@startuml UC-013: Cập nhật thông tin nhân viên

|HR Manager|
start
:Truy cập trang quản lý nhân viên;
:Chọn nhân viên cần cập nhật;

|System|
:Kiểm tra quyền cập nhật;
:Load thông tin nhân viên;

if (Có quyền cập nhật?) then (Có)
  :Lấy thông tin nhân viên từ DB;
  :Lấy lịch sử thay đổi;
  
  |HR Manager|
  :Hiển thị form chỉnh sửa;
  :Cập nhật thông tin nhân viên;
  note right
    - Thông tin cá nhân
    - Chức vụ và phòng ban
    - Thông tin liên hệ
    - Mức lương và phúc lợi
    - Quyền truy cập hệ thống
    - Trạng thái làm việc
  end note
  
  |System|
  :Validate thông tin đã cập nhật;
  :Kiểm tra quyền thay đổi;
  
  if (Thông tin hợp lệ?) then (Có)
    :Cập nhật thông tin trong DB;
    :Lưu lịch sử thay đổi;
    :Cập nhật thông tin trong User Service nếu cần;
    :Cập nhật thông tin trong Company Service nếu cần;
    
    if (Thay đổi quan trọng?) then (Có)
      :Gửi thông báo đến nhân viên;
      :Gửi thông báo đến HR Manager;
    endif
    
    |HR Manager|
    :Hiển thị thông báo cập nhật thành công;
    stop
  else (Không)
    |HR Manager|
    :Hiển thị lỗi validation;
    :Cho phép chỉnh sửa lại;
    stop
  endif
else (Không)
  |HR Manager|
  :Hiển thị lỗi không có quyền;
  stop
endif

@enduml
