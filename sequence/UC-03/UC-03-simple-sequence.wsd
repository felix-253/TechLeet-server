@startuml UC-03: Quản lý phòng ban

actor "Admin" as Admin
participant "Frontend" as FE
participant "API Gateway" as GW
participant "Company Service" as CS
database "PostgreSQL" as DB

Admin -> FE: Truy cập trang quản lý phòng ban
FE -> FE: Load department list template
FE --> Admin: Hiển thị danh sách phòng ban

Admin -> FE: Nhấn "Tạo phòng ban mới"
FE -> FE: Load create form template
FE --> Admin: Hiển thị form tạo phòng ban

Admin -> FE: Điền thông tin phòng ban\n(departmentName, description, budget)
Admin -> FE: Chọn headquarter và department type
FE -> FE: Validate client-side\n(department name required, budget format)
FE -> GW: POST /api/departments\n+ department data + JWT token
activate GW

GW -> GW: Extract JWT token
GW -> GW: Validate token format
GW -> CS: Forward request to Company Service
activate CS

CS -> CS: Validate dữ liệu đầu vào\n(department name, budget format)
CS -> CS: Check department name uniqueness
CS -> DB: SELECT COUNT(*) WHERE departmentName = ?
activate DB
DB --> CS: Department name count result
deactivate DB

alt Department name already exists
    CS --> GW: 400 Bad Request\n+ "Tên phòng ban đã tồn tại"
    GW --> FE: Error response
    FE --> Admin: Hiển thị lỗi tên phòng ban trùng lặp
else Department name is unique
    CS -> DB: INSERT INTO department\n(departmentName, description, budget, headquarterId, departmentTypeId)
    activate DB
    DB --> CS: Department created with ID
    deactivate DB
    
    CS -> CS: Generate department code\n(DEPT + timestamp)
    CS -> DB: UPDATE department SET departmentCode = ?
    activate DB
    DB --> CS: Update successful
    deactivate DB
    
    CS --> GW: 201 Created\n+ department data + departmentCode
    deactivate CS
    
    GW --> FE: Success response
    deactivate GW
    
    FE --> Admin: Hiển thị thông báo thành công\n+ Department ID + Department Code
end

@enduml
