@startuml UC-01: Đăng nhập hệ thống
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 5

actor "Nhân viên/Quản trị viên" as User
boundary "Giao diện đăng nhập" as LoginUI
control "AuthController" as AuthController
control "LocalStrategy" as LocalStrategy
control "AuthService" as AuthService
entity "EmployeeRepository" as EmployeeRepo

User -> LoginUI: Nhập email và mật khẩu
User -> LoginUI: Nhấn "Đăng nhập"

LoginUI -> AuthController: POST /auth/login\n(email, password)

AuthController -> LocalStrategy: validate(email, password)

LocalStrategy -> EmployeeRepo: employeeLogin(email)
activate EmployeeRepo
EmployeeRepo -> EmployeeRepo: findOne({ email })\nrelations: ['permissions']
EmployeeRepo --> LocalStrategy: EmployeeEntity
deactivate EmployeeRepo

LocalStrategy -> LocalStrategy: bcrypt.compareSync(password, employee.password)

alt [Password valid]
    LocalStrategy --> AuthController: EmployeeEntity
    AuthController -> AuthService: login(employee)
    activate AuthService
    
    AuthService -> AuthService: Get permissions from employee.permissions
    AuthService -> AuthService: Check if admin (permissionType == FULL)
    AuthService -> AuthService: removeSet(REDIS_KEY_EMPLOYEE_PERMISSION + employeeId)
    
    alt [Is Admin]
        AuthService -> AuthService: setSet(REDIS_KEY, [{permissionType: FULL}], TTL)
    else [Has Permissions]
        AuthService -> AuthService: Map permissions to Redis format
        AuthService -> AuthService: setSet(REDIS_KEY, permissionArray)
    else [No Permissions]
        AuthService -> AuthService: setSet(REDIS_KEY, [{VIEW, null, null}], TTL)
    end
    
    AuthService -> AuthService: Create payloadJwt = { employeeId }
    AuthService -> AuthService: Create payloadRefresh = { employeeId, isRefresh }
    AuthService -> AuthService: sign(payload) → accessToken
    AuthService -> AuthService: sign(payloadRefresh, expiresIn) → refreshToken
    
    AuthService --> AuthController: LoginResDto\n{ token, refreshToken, email, fullName, phoneNumber, avatarUrl, employeeId }
    deactivate AuthService
    
    AuthController --> LoginUI: 200 OK\nLoginResDto
    LoginUI -> User: Hiển thị trang chủ theo quyền
else [Password invalid]
    LocalStrategy --> AuthController: NotFoundException\n"Wrong email or password"
    AuthController --> LoginUI: 404 Not Found
    LoginUI -> User: Hiển thị lỗi đăng nhập
end

@enduml