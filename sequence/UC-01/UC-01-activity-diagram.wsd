@startuml UC-01: Đăng nhập hệ thống

|User|
start
:Nhập email, password;
:Nhấn "Đăng nhập";

|System|
:Tìm employee trong DB;
:Verify password với bcrypt;

if (Đăng nhập thành công?) then (Có)
  :Lấy permissions của employee;
  :Lưu permissions vào Redis;
  :Tạo JWT tokens;
  :Lưu refresh token;
  
  if (Permission type?) then (FULL - Admin)
    |User|
    :Chuyển đến Admin Dashboard;
    stop
  elseif (EDIT/VIEW - Employee)
    |User|
    :Chuyển đến Employee Dashboard;
    stop
  else (Không có quyền)
    |User|
    :Hiển thị lỗi quyền truy cập;
    stop
  endif
else (Không)
  |User|
  :Hiển thị lỗi;
  stop
endif

@enduml