@startuml UC-05: Xem danh sách tin tuyển dụng
hide footbox
skinparam ParticipantPadding 10
skinparam BoxPadding 5

actor "Người dùng" as User
boundary "Giao diện danh sách tin tuyển dụng" as JobListUI
control "JobPostingController" as JobPostingController
entity "JobPostingRepository" as JobPostingRepo
entity "AuthService" as AuthService
database "Cơ sở dữ liệu" as Database

User -> JobListUI: Truy cập trang danh sách tin tuyển dụng
JobListUI -> JobPostingController: Yêu cầu hiển thị danh sách tin
JobPostingController -> AuthService: Kiểm tra quyền truy cập
AuthService -> AuthService: Xác thực quyền người dùng
AuthService --> JobPostingController: Kết quả xác thực quyền
JobPostingController -> JobPostingRepo: Lấy danh sách tin tuyển dụng
JobPostingRepo -> Database: Truy vấn danh sách tin tuyển dụng
Database --> JobPostingRepo: Trả về danh sách tin tuyển dụng
JobPostingRepo --> JobPostingController: Dữ liệu danh sách tin
JobPostingController -> JobListUI: Hiển thị danh sách tin tuyển dụng

User -> JobListUI: Nhập bộ lọc/tìm kiếm (nếu có)

JobListUI -> JobPostingController: Gửi yêu cầu lọc/tìm kiếm
JobPostingController -> JobPostingController: Áp dụng bộ lọc và tìm kiếm
JobPostingController -> JobPostingRepo: Lấy kết quả đã lọc
JobPostingRepo -> Database: Truy vấn kết quả đã lọc
Database --> JobPostingRepo: Trả về kết quả đã lọc
JobPostingRepo --> JobPostingController: Dữ liệu kết quả đã lọc
JobPostingController -> JobListUI: Hiển thị kết quả đã lọc

alt [Cần xem chi tiết]
    User -> JobListUI: Click vào tin tuyển dụng
    JobListUI -> JobPostingController: Yêu cầu hiển thị chi tiết
    JobPostingController -> JobPostingRepo: Lấy thông tin chi tiết tin tuyển dụng
    JobPostingRepo -> Database: Truy vấn thông tin chi tiết
    Database --> JobPostingRepo: Trả về chi tiết tin tuyển dụng
    JobPostingRepo --> JobPostingController: Dữ liệu chi tiết tin tuyển dụng
    JobPostingController -> JobListUI: Hiển thị chi tiết tin tuyển dụng
    JobListUI -> User: Chuyển đến trang chi tiết tin tuyển dụng
else [Tiếp tục duyệt]
    JobListUI -> User: Hiển thị danh sách tin tuyển dụng
end

@enduml
