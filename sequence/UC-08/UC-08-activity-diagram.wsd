@startuml UC-08: Xem chi tiết đơn ứng tuyển

|Recruiter|
start
:Từ danh sách đơn ứng tuyển;
:Click vào đơn cần xem chi tiết;

|System|
:Kiểm tra quyền xem chi tiết;
:Load thông tin đơn ứng tuyển;

if (Có quyền xem?) then (Có)
  :Lấy thông tin đơn từ DB;
  :Lấy thông tin ứng viên;
  :Lấy thông tin tin tuyển dụng;
  :Load CV/Resume file;
  
  |Recruiter|
  :Hiển thị chi tiết đơn ứng tuyển;
  note right
    - Thông tin ứng viên
    - Thông tin tin tuyển dụng
    - CV/Resume
    - Thư xin việc
    - Trạng thái hiện tại
    - Lịch sử thay đổi
  end note
  
  if (Cần thực hiện hành động?) then (Có)
    if (Hành động?) then (Thay đổi trạng thái)
      :Chuyển đến trang cập nhật trạng thái;
      stop
    elseif (Lên lịch phỏng vấn)
      :Chuyển đến trang tạo lịch phỏng vấn;
      stop
    elseif (Tải CV)
      :Download CV file;
      stop
    else (Khác)
      :Thực hiện hành động tương ứng;
      stop
    endif
  else (Không)
    :Quay lại danh sách đơn ứng tuyển;
    stop
  endif
else (Không)
  |Recruiter|
  :Hiển thị lỗi không có quyền;
  stop
endif

@enduml
