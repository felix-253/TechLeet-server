@startuml UC-07: Quản lý đơn ứng tuyển

|Recruiter|
start
:Đăng nhập hệ thống;
:Truy cập trang quản lý đơn ứng tuyển;

|System|
:Kiểm tra quyền truy cập;
:Load danh sách đơn ứng tuyển;

if (Có quyền quản lý?) then (Có)
  :Lấy danh sách đơn từ DB;
  :Apply filters nếu có;
  note right
    - Lọc theo trạng thái
    - Lọc theo tin tuyển dụng
    - Lọc theo ứng viên
    - Lọc theo ngày nộp đơn
  end note
  
  :Phân trang kết quả;
  
  |Recruiter|
  :Hiển thị danh sách đơn ứng tuyển;
  :Cho phép tìm kiếm và lọc;
  
  if (Cần thay đổi trạng thái?) then (Có)
    :Chọn đơn ứng tuyển;
    :Chọn trạng thái mới;
    note right
      - SCREENING: Đang sàng lọc
      - INTERVIEWING: Đang phỏng vấn
      - REJECTED: Từ chối
      - HIRED: Tuyển dụng
    end note
    
    |System|
    :Cập nhật trạng thái trong DB;
    :Lưu lịch sử thay đổi;
    :Gửi thông báo đến ứng viên;
    
    |Recruiter|
    :Hiển thị thông báo cập nhật thành công;
    stop
  else (Không)
    :Tiếp tục duyệt danh sách;
    stop
  endif
else (Không)
  |Recruiter|
  :Hiển thị lỗi không có quyền;
  stop
endif

@enduml
